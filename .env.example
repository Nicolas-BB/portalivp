# Copie este arquivo para .env (na raiz) e ajuste se quiser.
# Os valores abaixo servem só para o desenvolvimento local: na VPS, use senhas fortes.

# Banco local (compose.dev.yaml)
POSTGRES_PASSWORD=dev-superuser
DB_OWNER_PASSWORD=dev-owner
DB_APP_PASSWORD=dev-app

# A API conecta com a role do app; as migrations usam a role dona.
DATABASE_URL=postgres://portalivp_app:dev-app@localhost:5432/portalivp
DATABASE_OWNER_URL=postgres://portalivp_owner:dev-owner@localhost:5432/portalivp

# Porta da API
PORT=3000
