{
  "name": "@portalivp/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "nest build && node dist/database/seeds/seed.js",
    "db:seed:demo": "nest build && node dist/database/seeds/demo.js",
    "auth:generate": "auth generate --config src/auth/cli.ts --output src/database/schema/auth.ts --yes",
    "auth:create-admin": "auth create-admin --config src/auth/cli.ts"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.18",
    "@nestjs/common": "^12.4.0",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.4.0",
    "@nestjs/platform-express": "^12.4.0",
    "@portalivp/shared": "*",
    "@thallesp/nestjs-better-auth": "^2.8.0",
    "better-auth": "^1.7.18",
    "drizzle-orm": "^0.45.4",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.12",
    "@nestjs/schematics": "^12.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "auth": "^1.7.18",
    "drizzle-kit": "^0.31.11",
    "source-map-support": "^0.5.21"
  }
}
